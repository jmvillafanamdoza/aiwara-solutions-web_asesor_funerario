---
import Base from '../layouts/Base.astro';
---
<Base pagina="404" titulo="Página no encontrada | Marco Villafana, Asesor Funerario" descripcion="La página que busca no existe." noindex>
  <section class="seccion">
    <div class="contenedor" style="max-width: 680px">
      <h1>No encontramos esta página</h1>
      <p class="intro">Puede que el enlace haya cambiado. Estas páginas pueden ayudarle:</p>
      <p style="display:flex;flex-wrap:wrap;gap:12px">
        <a class="btn btn--verde" href="/servicio-funerario">Servicio funerario</a>
        <a class="btn btn--contorno" href="/plan-funerario">Plan funerario</a>
        <a class="btn btn--contorno" href="/">Inicio</a>
      </p>
    </div>
  </section>
</Base>
