---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Contacto from '../components/Contacto.astro';
import BarraLlamada from '../components/BarraLlamada.astro';
import { SITE, enlaceTelefono, enlaceWhatsApp } from '../config/site';
import PlanesServicio from '../components/PlanesServicio.astro';
import CarruselServicios from '../components/CarruselServicios.astro';

const PAGINA = 'servicio-funerario';

const pasos = [
  { titulo: 'Comuníquese conmigo', texto: 'Llame o escriba a cualquier hora. Le indico qué hacer según el lugar donde ocurrió el fallecimiento: casa, clínica u hospital.' },
  { titulo: 'Tenga a la mano los documentos', texto: 'El DNI de la persona fallecida y el del familiar que hará los trámites.' },
  { titulo: 'Solicite el certificado de defunción', texto: 'Lo emite el médico que atendió a la persona o el del establecimiento de salud. Si tiene dudas, lo vemos juntos.' },
  { titulo: 'Elijamos juntos el servicio', texto: 'Entierro o cremación, el camposanto y el tipo de servicio, según lo que su familia desee.' },
  { titulo: 'Yo me encargo del resto', texto: 'Coordino el traslado, el velatorio, los trámites y los horarios, para que su familia pueda despedirse con tranquilidad.' },
];
---
<Base
  pagina={PAGINA}
  titulo="Servicio Funerario en Lima, Atención 24 Horas | Jardines de la Paz"
  descripcion="Servicio funerario en Lima con atención las 24 horas. Entierro o cremación, traslados y trámites con un asesor autorizado de Jardines de la Paz. Llame al 998 160 591."
>
  <!-- TELÉFONO 24 H -->
  <div class="franja-24h sobre-verde">
    <div class="contenedor franja-24h__fila">
      <p><Icono nombre="clock" tam={22} /><span><strong>Atención 24 horas</strong>, todos los días</span></p>
      <a class="franja-24h__tel" href={enlaceTelefono} data-ubicacion="franja-24h">
        <Icono nombre="phone" tam={24} /> {SITE.telefonoVisible}
      </a>
    </div>
  </div>

  <!-- HERO -->
  <section class="s-hero">
    <div class="contenedor s-hero__grid">
      <div>
        <h1>Servicio funerario en Lima</h1>
        <p class="s-hero__sub">Cuando una familia necesita ayuda, lo primero es tener a alguien que se encargue. Lo guío paso a paso, a cualquier hora.</p>
        <div class="s-hero__botones">
          <a class="btn btn--verde btn--grande" href={enlaceTelefono} data-ubicacion="hero">
            <Icono nombre="phone" /> Llamar ahora
          </a>
          <a class="btn btn--contorno btn--grande" href={enlaceWhatsApp(SITE.mensajesWhatsApp[PAGINA])} target="_blank" rel="noopener" data-ubicacion="hero">
            <Icono nombre="whatsapp-logo" /> Escribir por WhatsApp
          </a>
        </div>
        <a class="s-hero__catalogo" href={SITE.catalogoPdf.ruta} download data-ubicacion="hero">
          <Icono nombre="file-pdf" tam={22} /> Descargar el catálogo de servicios <span>(PDF, {SITE.catalogoPdf.peso})</span>
        </a>
      </div>
      <!-- Carrusel con los servicios (ver src/components/CarruselServicios.astro) -->
      <CarruselServicios />
    </div>
  </section>

  <!-- PRIMERAS HORAS -->
  <section class="seccion seccion--gris" aria-labelledby="pasos-titulo">
    <div class="contenedor">
      <h2 id="pasos-titulo" class="aparece">Qué hacer en las primeras horas</h2>
      <p class="intro aparece">No tiene que saberlo todo. Estos son los primeros pasos y en cada uno puedo ayudarle.</p>
      <ol class="pasos">
        {pasos.map((p) => (
          <li class="paso aparece">
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SERVICIOS (escenarios fijos con tarjetas que suben; ver src/components/PlanesServicio.astro) -->
  <PlanesServicio />

  <!-- TRASLADOS Y TRÁMITES -->
  <section class="seccion seccion--gris" aria-labelledby="tramites-titulo">
    <div class="contenedor">
      <h2 id="tramites-titulo" class="aparece">Traslados y trámites</h2>
      <div class="tramites">
        <div class="tramite aparece">
          <span class="tramite__icono"><Icono nombre="car-profile" tam={30} /></span>
          <h3>Traslados</h3>
          <p>Coordinamos el traslado desde la casa, clínica u hospital hacia el velatorio y luego al camposanto. Realizamos el servicio para entierro o cremación hacia todos los camposantos de Lima.</p>
        </div>
        <div class="tramite aparece">
          <span class="tramite__icono"><Icono nombre="file-text" tam={30} /></span>
          <h3>Trámites</h3>
          <p>Le ayudo con la documentación y las coordinaciones con el camposanto. En caso de cremación, el servicio incluye los trámites ante el área de salud y la necropsia de ley.</p>
        </div>
        <div class="tramite tramite--verde sobre-verde aparece">
          <h3>¿Prefiere que lo llame?</h3>
          <p>Escríbame su número por WhatsApp y lo llamo de inmediato.</p>
          <a class="btn btn--dorado" href={enlaceWhatsApp('Hola Marco, por favor llámame. Mi número es: ')} target="_blank" rel="noopener" data-ubicacion="pedir-llamada">
            <Icono nombre="whatsapp-logo" tam={20} /> Pedir que me llame
          </a>
        </div>
      </div>
    </div>
  </section>

  <Contacto pagina={PAGINA} titulo="Estoy disponible las 24 horas" texto="Llame o escriba en cualquier momento. Le respondo personalmente y lo acompaño en cada paso." />
  <BarraLlamada pagina={PAGINA} />
</Base>

<style>
  .franja-24h { background: var(--verde-hondo); color: #fff; }
  .franja-24h__fila { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding-block: 12px; }
  .franja-24h p { margin: 0; display: flex; align-items: center; gap: 8px; }
  .franja-24h p :global(.icono) { color: var(--dorado); }
  .franja-24h__tel {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px;
    font: 700 1.6rem/1 var(--f-texto); color: var(--dorado); text-decoration: none; letter-spacing: 0.01em;
  }
  .franja-24h__tel:hover { color: #fff; }
  @media (max-width: 520px) { .franja-24h__fila { justify-content: center; text-align: center; } .franja-24h__tel { font-size: 1.75rem; } }

  .s-hero { padding: 40px 0 56px; }
  .s-hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 980px) { .s-hero__grid { grid-template-columns: 1fr 1fr; gap: 56px; } .s-hero { padding: 48px 0 72px; } }
  .s-hero__sub { font-size: 1.2rem; color: var(--texto-2); max-width: 42ch; margin-bottom: 28px; }
  .s-hero__botones { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 520px) { .s-hero__botones .btn { width: 100%; } }
  .s-hero__grid > * { min-width: 0; }
  .s-hero__catalogo { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; min-height: 44px; margin-top: 16px; font-weight: 600; }
  .s-hero__catalogo span { font-weight: 400; color: var(--texto-2); }

  .pasos { list-style: none; counter-reset: paso; padding: 0; margin: 32px 0 0; display: grid; gap: 16px; }
  @media (min-width: 860px) { .pasos { grid-template-columns: repeat(6, 1fr); } .paso { grid-column: span 2; } .paso:nth-child(4) { grid-column: 2 / span 2; } }
  .paso {
    counter-increment: paso; position: relative; background: #fff; border-radius: var(--radio);
    padding: 24px 24px 22px 76px; box-shadow: 0 1px 0 var(--gris-borde);
  }
  .paso::before {
    content: counter(paso); position: absolute; left: 20px; top: 22px;
    width: 40px; height: 40px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--verde); color: var(--dorado); font: 700 1.1rem/1 var(--f-texto);
  }
  .paso h3 { font-size: 1.4rem; margin-bottom: 6px; }
  .paso p { margin: 0; color: var(--texto-2); }


  .tramites { display: grid; gap: 16px; margin-top: 28px; }
  @media (min-width: 860px) { .tramites { grid-template-columns: 1fr 1fr 0.9fr; } }
  .tramite { background: #fff; border-radius: var(--radio); padding: 28px; }
  .tramite p { color: var(--texto-2); margin: 0; }
  .tramite__icono {
    display: inline-flex; width: 56px; height: 56px; border-radius: var(--radio); margin-bottom: 14px;
    align-items: center; justify-content: center; background: var(--verde-claro); color: var(--verde);
  }
  .tramite--verde { background: var(--verde); color: #fff; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .tramite--verde h3 { color: #fff; margin: 0; }
  .tramite--verde p { color: rgb(255 255 255 / 0.88); }

  /* Espacio para la barra fija de llamada en celular */
  @media (max-width: 767px) { :global(.pie) { padding-bottom: 120px; } }
</style>
