---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Testimonios from '../components/Testimonios.astro';
import Contacto from '../components/Contacto.astro';
import { SITE, enlaceTelefono } from '../config/site';
import { imagen } from '../lib/imagenes';

// Fotos del hero que se alternan (espacios hero-inicio y hero-2 a hero-5 de imagenes.mapa.json)
const slides = (['hero-inicio', 'hero-2', 'hero-3', 'hero-4', 'hero-5'] as const).map(imagen);
const retrato = imagen('marco-retrato');
const logoBlanco = imagen('logo-jdlp-blanco');
const equipo = imagen('marco-equipo');
const laMolina = imagen('cs-la-molina');
const lurin = imagen('cs-lurin');
const galeria = (['galeria-1', 'galeria-2', 'galeria-3', 'galeria-4', 'galeria-5'] as const).map(imagen);

const motivos = [
  { icono: 'user-circle', titulo: 'Una sola persona de contacto', texto: 'Usted habla siempre conmigo, de día o de noche, desde la primera consulta.' },
  { icono: 'list-checks', titulo: 'Opciones explicadas con claridad', texto: 'Le muestro qué incluye cada servicio, lote o nicho, y cómo quedan las cuotas.' },
  { icono: 'file-text', titulo: 'Trámites y coordinación', texto: 'Coordino documentos, traslados y horarios con el camposanto para que su familia no tenga que hacerlo.' },
  { icono: 'handshake', titulo: 'Acompañamiento después', texto: 'Sigo disponible para pagos, cambios o cualquier consulta, el tiempo que haga falta.' },
];
---
<Base
  pagina="inicio"
  titulo="Asesor Funerario en Lima | Marco Villafana, Jardines de la Paz"
  descripcion="Marco Antonio Villafana, asesor funerario autorizado de Jardines de la Paz en Lima. Servicio funerario las 24 horas y planes en cuotas en La Molina y Lurín."
>
  <!-- HERO (inspirado en la composición de urgelbourgie.com: foto a la izquierda que se funde en un panel verde con el texto a la derecha) -->
  <section class="hero sobre-verde">
    <div class="hero__fotos" data-slides aria-roledescription="carrusel" aria-label="Fotos de los camposantos">
      {slides.map((s, i) => (
        <Picture
          src={s.src} alt={s.alt} formats={['webp']} widths={[400, 640]}
          sizes="(min-width: 980px) 62vw, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'}
          pictureAttributes={{ class: `hero__slide${i === 0 ? ' activa' : ''}`, 'aria-hidden': i === 0 ? undefined : 'true' }}
        />
      ))}
      <div class="hero__controles">
        {slides.map((_, i) => (
          <button type="button" class="hero__punto" data-ir={i} aria-label={`Ver foto ${i + 1} de ${slides.length}`} aria-current={i === 0 ? 'true' : undefined}><span></span></button>
        ))}
        <button type="button" class="hero__pausa" data-pausa aria-label="Pausar fotos">
          <span class="hero__pausa-ico" data-ico="pausa"><Icono nombre="pause" tam={16} /></span>
          <span class="hero__pausa-ico" data-ico="play" hidden><Icono nombre="play" tam={16} /></span>
        </button>
      </div>
    </div>

    <div class="contenedor hero__grid">
      <figure class="hero__marco">
        <Picture src={retrato.src} alt={retrato.alt} formats={['webp']} widths={[120, 240]} sizes="120px" loading="eager" class="hero__retrato" />
        <figcaption>
          <strong>{SITE.nombre}</strong>
          <span>{SITE.aniosExperiencia} años de experiencia</span>
        </figcaption>
      </figure>

      <div class="hero__texto">
        <Image src={logoBlanco.src} alt={logoBlanco.alt} height={64} densities={[1, 2]} loading="eager" class="hero__logo" />
        <h1>
          <span class="hero__pre">Asesor Funerario Autorizado</span>
          <span class="hero__titulo">de Jardines de la Paz</span>
        </h1>
        <p class="hero__sub">Acompaño a su familia con respeto, para resolver hoy o planificar con tiempo, en La Molina y Lurín.</p>
        <div class="hero__botones">
          <a class="btn btn--dorado btn--grande" href="/servicio-funerario">
            <Icono nombre="phone-call" /> Necesito ayuda ahora
          </a>
          <a class="btn btn--claro btn--grande" href="/plan-funerario">
            <Icono nombre="calendar-check" /> Quiero planificar
          </a>
        </div>
        <p class="hero__24h">
          <span>Atención 24 horas</span>
          <span class="hero__linea" aria-hidden="true"></span>
          <a href={enlaceTelefono} data-ubicacion="hero-24h">{SITE.telefonoVisible}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- QUIÉN ES MARCO -->
  <section class="seccion" id="quien-es-marco" aria-labelledby="marco-titulo">
    <div class="contenedor marco">
      <div class="marco__foto aparece">
        <Picture src={equipo.src} alt={equipo.alt} formats={['webp']} widths={[480, 800, 1200]} sizes="(min-width: 980px) 50vw, 100vw" />
      </div>
      <div class="marco__texto aparece">
        <h2 id="marco-titulo">{SITE.aniosExperiencia} años acompañando a familias de Lima</h2>
        <p>
          Soy {SITE.nombre}, asesor funerario autorizado de Jardines de la Paz.
          Ayudo a las familias a elegir un servicio funerario o un plan de previsión con información clara y sin presiones.
        </p>
        <p>Lo atiendo personalmente: le explico las opciones, las cuotas y los trámites, y sigo a su lado después.</p>
        <dl class="marco__datos">
          <div><dt>{SITE.aniosExperiencia} años</dt><dd>en el rubro funerario</dd></div>
          <div><dt>2 camposantos</dt><dd>La Molina y Lurín</dd></div>
          <div><dt>24 horas</dt><dd>de atención</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- CAMPOSANTOS -->
  <section class="seccion seccion--gris" id="camposantos" aria-labelledby="camposantos-titulo">
    <div class="contenedor">
      <h2 id="camposantos-titulo" class="aparece">Nuestros camposantos en Lima</h2>
      <p class="intro aparece">Jardines amplios y cuidados, pensados para visitar a sus seres queridos con tranquilidad.</p>

      <div class="sedes">
        <article class="sede sede--grande aparece">
          <Picture src={laMolina.src} alt={laMolina.alt} formats={['webp']} widths={[480, 800, 1000]} sizes="(min-width: 980px) 60vw, 100vw" />
          <div class="sede__info">
            <h3>La Molina</h3>
            <p>Rodeado de cerros y áreas verdes, con su conocida pirámide y el sector Praderas de la Paz.</p>
            <p class="sede__dir"><Icono nombre="map-pin" tam={20} /> {SITE.sedes[0].direccion}, {SITE.sedes[0].distrito}</p>
            {SITE.sedes[0].recorrido3d && (
              <a class="btn btn--contorno sede__recorrido" href={SITE.sedes[0].recorrido3d} target="_blank" rel="noopener" data-ubicacion="camposantos-la-molina">
                <Icono nombre="cube-focus" tam={22} /> Recorrido virtual 3D
                <span class="sr-only">(abre en otra pestaña)</span>
                <Icono nombre="arrow-square-out" tam={18} />
              </a>
            )}
          </div>
        </article>
        <article class="sede aparece">
          <Picture src={lurin.src} alt={lurin.alt} formats={['webp']} widths={[400, 607]} sizes="(min-width: 980px) 36vw, 100vw" />
          <div class="sede__info">
            <h3>Lurín</h3>
            <p>Amplios jardines al sur de Lima y una capilla para despedir a sus seres queridos.</p>
            <p class="sede__dir"><Icono nombre="map-pin" tam={20} /> {SITE.sedes[1].direccion}, {SITE.sedes[1].distrito}</p>
            {SITE.sedes[1].recorrido3d && (
              <a class="btn btn--contorno sede__recorrido" href={SITE.sedes[1].recorrido3d} target="_blank" rel="noopener" data-ubicacion="camposantos-lurin">
                <Icono nombre="cube-focus" tam={22} /> Recorrido virtual 3D
                <span class="sr-only">(abre en otra pestaña)</span>
                <Icono nombre="arrow-square-out" tam={18} />
              </a>
            )}
          </div>
        </article>
      </div>

      <ul class="galeria" aria-label="Fotos del camposanto">
        {galeria.map((g, i) => (
          <li class={`galeria__item galeria__item--${i + 1} aparece`}>
            <Picture src={g.src} alt={g.alt} formats={['webp']} widths={[360, 640]} sizes="(min-width: 980px) 33vw, (min-width: 860px) 36vw, 100vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- POR QUÉ CON UN ASESOR -->
  <section class="seccion" aria-labelledby="asesor-titulo">
    <div class="contenedor asesor">
      <div class="asesor__cabeza aparece">
        <h2 id="asesor-titulo">¿Por qué hacerlo con un asesor?</h2>
        <p class="intro">Una decisión así merece tiempo, información clara y alguien de confianza que responda sus preguntas.</p>
        <div class="asesor__caminos">
          <a class="camino" href="/servicio-funerario">
            <span class="camino__titulo">Servicio funerario</span>
            <span class="camino__texto">Atención inmediata, las 24 horas</span>
            <Icono nombre="arrow-right" />
          </a>
          <a class="camino" href="/plan-funerario">
            <span class="camino__titulo">Plan funerario</span>
            <span class="camino__texto">Previsión en cuotas sin intereses</span>
            <Icono nombre="arrow-right" />
          </a>
        </div>
      </div>
      <ul class="motivos">
        {motivos.map((m) => (
          <li class="motivo aparece">
            <span class="motivo__icono"><Icono nombre={m.icono} tam={28} /></span>
            <div>
              <h3>{m.titulo}</h3>
              <p>{m.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Testimonios />
  <Contacto pagina="inicio" />
</Base>

<style>
  /* Hero: panel verde con la foto a la izquierda fundiéndose en él */
  .hero { position: relative; overflow: hidden; isolation: isolate; background: var(--verde-hondo); color: #fff; }
  /* Luz dorada muy tenue que se desplaza lentamente en el panel verde */
  .hero::before {
    content: ''; position: absolute; z-index: 0; right: -10%; top: -25%; width: 60vw; height: 60vw; max-width: 820px; max-height: 820px;
    background: radial-gradient(closest-side, rgb(230 195 90 / 0.14), rgb(45 106 76 / 0.12) 55%, transparent 75%);
    pointer-events: none;
  }

  /* Fotos */
  .hero__fotos { position: relative; aspect-ratio: 4 / 3; overflow: hidden; z-index: 1; }
  .hero__fotos :global(.hero__slide) { position: absolute; inset: 0; opacity: 0; transition: opacity 1.6s ease; }
  .hero__fotos :global(.hero__slide.activa) { opacity: 1; }
  .hero__fotos :global(.hero__slide img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; transform-origin: 40% 50%; }
  /* Fundido de la foto hacia el verde: abajo en celular, a la derecha en escritorio */
  .hero__fotos::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgb(22 58 40 / 0.25) 0%, transparent 25%, transparent 60%, var(--verde-hondo) 100%);
  }
  .hero__controles { position: absolute; top: 12px; left: 12px; z-index: 2; display: flex; align-items: center; gap: 2px; }
  .hero__punto { width: 32px; height: 32px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .hero__punto span { display: block; width: 18px; height: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.55); transition: width 0.3s ease, background-color 0.3s ease; }
  .hero__punto[aria-current='true'] span { width: 28px; background: #fff; }
  .hero__pausa {
    width: 32px; height: 32px; margin-left: 6px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgb(255 255 255 / 0.9); color: var(--verde-hondo); display: grid; place-items: center;
  }
  .hero__pausa-ico { display: grid; place-items: center; }
  .hero__pausa-ico[hidden] { display: none; }

  /* Contenido */
  .hero__grid { position: relative; z-index: 2; display: grid; gap: 24px; padding-block: 0 48px; }
  .hero__marco {
    margin: -64px 0 0; justify-self: start;
    display: flex; align-items: center; gap: 14px;
    background: #fff; color: var(--tinta); padding: 10px 18px 10px 10px; border-radius: 999px;
    box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.45); max-width: 100%;
  }
  .hero :global(.hero__retrato) { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; border: 3px solid var(--dorado); }
  .hero__marco figcaption { display: grid; line-height: 1.3; font-size: 0.92rem; }
  .hero__marco strong { color: var(--verde-hondo); }
  .hero__marco span { color: var(--texto-2); }

  .hero :global(.hero__logo) { height: 48px; width: auto; margin-bottom: 22px; opacity: 0.95; }
  .hero h1 { color: #fff; margin-bottom: 18px; }
  .hero__pre { display: block; font: 500 1.15rem/1.3 var(--f-texto); color: var(--dorado); letter-spacing: 0.01em; margin-bottom: 6px; }
  .hero__titulo { display: block; font-size: clamp(2.5rem, 7vw, 4.2rem); line-height: 1.02; }
  .hero__sub { font-size: 1.15rem; color: rgb(255 255 255 / 0.86); max-width: 38ch; margin-bottom: 26px; }
  .hero__botones { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 520px) { .hero__botones .btn { width: 100%; } }
  .hero__24h { display: flex; align-items: center; gap: 14px; margin: 26px 0 0; font-weight: 600; letter-spacing: 0.02em; }
  .hero__24h span:first-child { font-size: 0.95rem; text-transform: uppercase; white-space: nowrap; }
  .hero__linea { position: relative; flex: 0 1 110px; min-width: 28px; height: 2px; background: var(--dorado); border-radius: 2px; }
  .hero__linea::before { content: ''; position: absolute; left: -2px; top: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--dorado); }
  .hero__24h a { color: #fff; font-size: 1.2rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .hero__24h a:hover { color: var(--dorado); }

  @media (min-width: 980px) {
    .hero { min-height: clamp(580px, calc(100dvh - 72px), 760px); display: grid; }
    .hero__fotos { position: absolute; inset: 0 auto 0 0; width: 62%; aspect-ratio: auto; }
    .hero__fotos::after { background: linear-gradient(90deg, rgb(22 58 40 / 0.1) 0%, transparent 30%, rgb(22 58 40 / 0.55) 72%, var(--verde-hondo) 100%); }
    .hero__controles { top: auto; bottom: 20px; left: max(16px, calc((100vw - var(--ancho)) / 2 + var(--gutter))); }
    .hero__grid { grid-template-columns: 1fr 0.86fr; align-items: center; gap: 48px; padding-block: 72px; }
    .hero__marco { margin: 0; align-self: end; margin-bottom: 36px; }
    .hero__texto { grid-column: 2; grid-row: 1; }
    .hero :global(.hero__logo) { height: 60px; margin-bottom: 28px; }
    .hero__botones .btn { min-height: 54px; padding-inline: 18px; font-size: 1rem; }
  }

  /* Movimiento: solo si la persona no pidió reducirlo */
  @media (prefers-reduced-motion: no-preference) {
    .hero::before { animation: luz 18s ease-in-out infinite alternate; }
    .hero__fotos :global(.hero__slide.activa img) { animation: acercar 9s ease-out both; }
    .hero__texto > * { animation: subir 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .hero__texto > :nth-child(2) { animation-delay: 0.1s; }
    .hero__texto > :nth-child(3) { animation-delay: 0.2s; }
    .hero__texto > :nth-child(4) { animation-delay: 0.3s; }
    .hero__texto > :nth-child(5) { animation-delay: 0.4s; }
    .hero__fotos { animation: aparecer 1.4s ease both; }
    .hero__marco { animation: subir 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both; }
    .hero__linea { transform-origin: left; animation: trazo 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.9s both; }
  }
  @keyframes subir { from { opacity: 0; transform: translateY(18px); } }
  @keyframes aparecer { from { opacity: 0; } }
  @keyframes acercar { from { transform: scale(1); } to { transform: scale(1.07); } }
  @keyframes luz { from { transform: translate(0, 0); } to { transform: translate(-14%, 12%); } }
  @keyframes trazo { from { transform: scaleX(0); } }

  /* Quién es Marco */
  .marco { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 980px) { .marco { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .marco__foto :global(img) { border-radius: var(--radio); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .marco__datos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 28px 0 0; }
  .marco__datos div { border-top: 3px solid var(--dorado); padding-top: 10px; }
  .marco__datos dt { font: 600 1.5rem/1.1 var(--f-titulo); color: var(--verde); }
  .marco__datos dd { margin: 4px 0 0; font-size: 0.92rem; color: var(--texto-2); line-height: 1.35; }
  .marco__datos dt { font-variant-numeric: lining-nums; }
  @media (max-width: 520px) {
    .marco__datos { grid-template-columns: 1fr; gap: 0; }
    .marco__datos div { display: flex; align-items: baseline; gap: 10px; border-top: 0; border-left: 3px solid var(--dorado); padding: 6px 0 6px 12px; margin-bottom: 8px; }
    .marco__datos dd { margin: 0; }
  }

  /* Camposantos */
  .sedes { display: grid; gap: 20px; margin: 32px 0 20px; }
  @media (min-width: 980px) { .sedes { grid-template-columns: 1.6fr 1fr; } }
  .sede { background: #fff; border-radius: var(--radio); overflow: hidden; box-shadow: var(--sombra); display: flex; flex-direction: column; }
  .sede :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  @media (min-width: 980px) { .sede--grande :global(img) { aspect-ratio: 16 / 9.2; } .sede:not(.sede--grande) :global(img) { aspect-ratio: 1 / 0.82; } }
  .sede__info { padding: 22px 24px 24px; }
  .sede__info h3 { margin-bottom: 6px; }
  .sede__dir { display: flex; gap: 8px; align-items: center; margin: 0; color: var(--texto-2); font-size: 0.95rem; }
  .sede__dir :global(.icono) { color: var(--verde-medio); flex: none; }
  .sede__info { display: flex; flex-direction: column; align-items: flex-start; flex: 1; }
  .sede__info .sede__dir { margin-bottom: 18px; }
  .sede__recorrido { margin-top: auto; min-height: 48px; padding-inline: 18px; }
  @media (max-width: 520px) { .sede__recorrido { width: 100%; } }

  .galeria { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  .galeria__item :global(picture) { display: block; height: 100%; }
  .galeria__item :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radio); aspect-ratio: 4 / 3; }
  .galeria__item--1, .galeria__item--5 { grid-column: span 2; }
  .galeria__item--3 { grid-row: span 2; }
  .galeria__item--3 :global(img) { aspect-ratio: auto; }
  @media (min-width: 860px) {
    /* 3 columnas: dos fotos a cada lado y la capilla vertical al centro */
    .galeria {
      grid-template-columns: 1.3fr 1fr 1.3fr;
      grid-template-rows: 230px 230px;
      grid-template-areas: 'a c d' 'b c e';
    }
    .galeria__item :global(img) { aspect-ratio: auto; }
    .galeria__item--1 { grid-area: a; }
    .galeria__item--2 { grid-area: b; }
    .galeria__item--3 { grid-area: c; }
    .galeria__item--4 { grid-area: d; }
    .galeria__item--5 { grid-area: e; }
  }

  /* Por qué un asesor */
  .asesor { display: grid; gap: 40px; }
  @media (min-width: 980px) { .asesor { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; } .asesor__cabeza { position: sticky; top: 104px; } }
  .asesor__caminos { display: grid; gap: 12px; margin-top: 24px; }
  .camino {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2px 16px;
    padding: 18px 20px; border-radius: var(--radio); text-decoration: none;
    background: var(--verde); color: #fff;
    transition: background-color 0.2s ease;
  }
  .camino:hover { background: var(--verde-hondo); color: #fff; }
  .camino__titulo { font: 600 1.35rem/1.2 var(--f-titulo); }
  .camino__texto { grid-row: 2; font-size: 0.95rem; color: var(--dorado); }
  .camino :global(.icono) { grid-row: span 2; grid-column: 2; }
  .motivos { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .motivo { display: grid; grid-template-columns: 56px 1fr; gap: 18px; padding: 22px 0; border-bottom: 1px solid var(--gris-borde); }
  .motivo:last-child { border-bottom: 0; }
  .motivo h3 { font-size: 1.45rem; margin-bottom: 4px; }
  .motivo p { margin: 0; color: var(--texto-2); }
  .motivo__icono {
    width: 56px; height: 56px; border-radius: var(--radio);
    background: var(--verde-claro); color: var(--verde);
    display: inline-flex; align-items: center; justify-content: center;
  }
</style>

<script>
  // Fotos del hero: se alternan cada 6,5 s con fundido. Quedan quietas si se pide reducir movimiento,
  // si la pestaña no está visible o si la persona pulsa el botón de pausa.
  const cont = document.querySelector<HTMLElement>('[data-slides]');
  if (cont) {
    const slides = [...cont.querySelectorAll<HTMLElement>('.hero__slide')];
    const puntos = [...cont.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const pausa = cont.querySelector<HTMLButtonElement>('[data-pausa]')!;
    const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    let timer: number | undefined;
    let pausado = reducir;

    const ir = (n: number) => {
      slides[actual].classList.remove('activa');
      slides[actual].setAttribute('aria-hidden', 'true');
      puntos[actual].removeAttribute('aria-current');
      actual = (n + slides.length) % slides.length;
      slides[actual].classList.add('activa');
      slides[actual].removeAttribute('aria-hidden');
      puntos[actual].setAttribute('aria-current', 'true');
    };
    const detener = () => { clearInterval(timer); timer = undefined; };
    const iniciar = () => { detener(); if (!pausado && !document.hidden) timer = window.setInterval(() => ir(actual + 1), 6500); };
    const pintarPausa = () => {
      pausa.setAttribute('aria-label', pausado ? 'Reanudar fotos' : 'Pausar fotos');
      pausa.querySelector<HTMLElement>('[data-ico="pausa"]')!.hidden = pausado;
      pausa.querySelector<HTMLElement>('[data-ico="play"]')!.hidden = !pausado;
    };

    puntos.forEach((b) => b.addEventListener('click', () => { ir(Number(b.dataset.ir)); iniciar(); }));
    pausa.addEventListener('click', () => { pausado = !pausado; pintarPausa(); iniciar(); });
    document.addEventListener('visibilitychange', iniciar);
    pintarPausa();
    iniciar();
  }
</script>
