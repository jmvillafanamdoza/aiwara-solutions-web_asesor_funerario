---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Contacto from '../components/Contacto.astro';
import FormCotizacion from '../components/FormCotizacion.astro';
import { SITE, enlaceWhatsApp } from '../config/site';
import { imagen } from '../lib/imagenes';

const PAGINA = 'plan-funerario';
const hero = imagen('plan-hero');
const lotes = imagen('plan-lotes');
const praderas = imagen('plan-praderas');

const beneficios = [
  { icono: 'piggy-bank', titulo: 'Ahorro', texto: 'Al contratar con anticipación accede a un precio menor que en una necesidad inmediata.' },
  { icono: 'calendar-check', titulo: 'Pago en cuotas', texto: 'Divida el pago en cuotas mensuales sin intereses, según el plan elegido.' },
  { icono: 'heart', titulo: 'Tranquilidad para su familia', texto: 'Sus seres queridos no tendrán que decidir ni pagar en un momento difícil.' },
  { icono: 'map-pin', titulo: 'Usted elige el lugar', texto: 'Escoja con calma el camposanto, la ubicación y el tipo de espacio.' },
];

const otras = [
  { icono: 'squares-four', titulo: 'Nichos', texto: 'Espacios en pared en La Molina y Lurín, con lápida de mármol y florero.' },
  { icono: 'flower-lotus', titulo: 'Cinerarios', texto: 'Espacios para conservar las cenizas de sus seres queridos.', pendiente: '[DETALLE POR CONFIRMAR]' },
  { icono: 'flower-tulip', titulo: 'Cremación', texto: 'Servicio de cremación en la sede de La Molina, con maestro de ceremonia, responso y acta de cremación.' },
  { icono: 'church', titulo: 'Servicio funerario a futuro', texto: 'Deje contratado el servicio Especial, Premium o Platinum y páguelo en cuotas.' },
];
---
<Base
  pagina={PAGINA}
  titulo="Plan Funerario en Cuotas en Lima | La Molina y Lurín"
  descripcion="Plan funerario en cuotas sin intereses en Lima. Lotes, nichos, cinerarios y cremación en los camposantos de Jardines de la Paz en La Molina y Lurín. Pida su cotización."
>
  <!-- HERO -->
  <section class="p-hero">
    <div class="contenedor p-hero__grid">
      <div>
        <h1>Plan funerario en cuotas</h1>
        <p class="p-hero__sub">Elija hoy con calma el servicio y el lugar, y pague en cuotas sin intereses. En La Molina y Lurín.</p>
        <div class="p-hero__botones">
          <a class="btn btn--verde btn--grande" href="#cotizar"><Icono nombre="clipboard-text" /> Cotizar mi plan</a>
          <a class="btn btn--contorno btn--grande" href={enlaceWhatsApp(SITE.mensajesWhatsApp[PAGINA])} target="_blank" rel="noopener" data-ubicacion="hero">
            <Icono nombre="whatsapp-logo" /> Escribir por WhatsApp
          </a>
        </div>
      </div>
      <Picture src={hero.src} alt={hero.alt} formats={['webp']} widths={[640, 960, 1280]} sizes="(min-width: 980px) 48vw, 100vw" loading="eager" fetchpriority="high" class="p-hero__foto" />
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="seccion seccion--verde sobre-verde" aria-labelledby="beneficios-titulo">
    <div class="contenedor">
      <h2 id="beneficios-titulo" class="aparece">Beneficios de anticiparse</h2>
      <ul class="beneficios">
        {beneficios.map((b) => (
          <li class="beneficio aparece">
            <Icono nombre={b.icono} tam={34} />
            <h3>{b.titulo}</h3>
            <p>{b.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- OPCIONES -->
  <section class="seccion" aria-labelledby="opciones-titulo">
    <div class="contenedor">
      <h2 id="opciones-titulo" class="aparece">Opciones para su plan</h2>
      <p class="intro aparece">Le ayudo a comparar cada opción según su presupuesto y lo que su familia desea.</p>

      <div class="destacadas">
        <article class="opcion-foto aparece">
          <Picture src={lotes.src} alt={lotes.alt} formats={['webp']} widths={[480, 800, 1200]} sizes="(min-width: 980px) 58vw, 100vw" />
          <div class="opcion-foto__info">
            <h3>Lotes en jardín: simple, doble y triple</h3>
            <p>Espacios perpetuos en jardín para una, dos o tres personas, con lápida de mármol. En La Molina y Lurín.</p>
          </div>
        </article>
        <article class="opcion-foto opcion-foto--vertical aparece">
          <Picture src={praderas.src} alt={praderas.alt} formats={['webp']} widths={[400, 720]} sizes="(min-width: 980px) 34vw, 100vw" />
          <div class="opcion-foto__info">
            <h3>Praderas de la Paz</h3>
            <p>Sector de jardines en La Molina, alrededor de su monumento central.</p>
          </div>
        </article>
      </div>

      <ul class="otras">
        {otras.map((o) => (
          <li class="otra aparece">
            <span class="otra__icono"><Icono nombre={o.icono} tam={28} /></span>
            <div>
              <h3>{o.titulo}</h3>
              <p>{o.texto} {o.pendiente && <span class="marcador">{o.pendiente}</span>}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FORMULARIO -->
  <section class="seccion seccion--gris" id="cotizar" aria-labelledby="cotizar-titulo">
    <div class="contenedor cotizar">
      <div class="aparece">
        <h2 id="cotizar-titulo">Reciba su cotización por WhatsApp</h2>
        <p class="intro">Complete sus datos y le envío las opciones y cuotas que mejor se ajustan a su familia.</p>
        <ul class="lista-check cotizar__puntos">
          <li><Icono nombre="check" tam={20} />Sin compromiso</li>
          <li><Icono nombre="check" tam={20} />Le responde Marco personalmente</li>
          <li><Icono nombre="check" tam={20} />Cuotas sin intereses según el plan</li>
        </ul>
      </div>
      <div class="aparece">
        <FormCotizacion />
      </div>
    </div>
  </section>

  <Contacto pagina={PAGINA} titulo="¿Prefiere conversarlo?" texto="Llámeme o escríbame y le explico cada opción con calma, sin compromiso." />
</Base>

<style>
  .p-hero { padding: 40px 0 56px; background: linear-gradient(180deg, var(--gris-claro) 0%, #fff 100%); }
  .p-hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 980px) { .p-hero__grid { grid-template-columns: 1fr 1fr; gap: 56px; } .p-hero { padding: 64px 0 80px; } }
  .p-hero__sub { font-size: 1.2rem; color: var(--texto-2); max-width: 40ch; margin-bottom: 28px; }
  .p-hero__botones { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 520px) { .p-hero__botones .btn { width: 100%; } }
  .p-hero :global(.p-hero__foto) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radio); box-shadow: var(--sombra); }

  .beneficios { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 28px; }
  @media (min-width: 640px) { .beneficios { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .beneficios { grid-template-columns: repeat(4, 1fr); gap: 32px; } }
  .beneficio { border-top: 2px solid var(--dorado); padding-top: 18px; }
  .beneficio :global(.icono) { color: var(--dorado); margin-bottom: 12px; }
  .beneficio h3 { font-size: 1.5rem; margin-bottom: 6px; }
  .beneficio p { margin: 0; color: rgb(255 255 255 / 0.86); }

  .destacadas { display: grid; gap: 20px; margin: 32px 0 20px; }
  @media (min-width: 980px) { .destacadas { grid-template-columns: 1.6fr 1fr; } }
  .opcion-foto { position: relative; border-radius: var(--radio); overflow: hidden; min-height: 320px; display: flex; align-items: flex-end; }
  .opcion-foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .opcion-foto__info {
    position: relative; width: 100%; padding: 80px 24px 24px; color: #fff;
    background: linear-gradient(180deg, transparent 0%, rgb(14 38 26 / 0.88) 55%);
  }
  .opcion-foto__info h3 { color: #fff; margin-bottom: 6px; }
  .opcion-foto__info p { margin: 0; color: rgb(255 255 255 / 0.92); }
  @media (min-width: 980px) { .opcion-foto { min-height: 440px; } }

  .otras { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  @media (min-width: 760px) { .otras { grid-template-columns: 1fr 1fr; } }
  .otra { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: 22px; border: 1px solid var(--gris-borde); border-radius: var(--radio); }
  .otra h3 { font-size: 1.4rem; margin-bottom: 4px; }
  .otra p { margin: 0; color: var(--texto-2); }
  .otra__icono { width: 56px; height: 56px; border-radius: var(--radio); background: var(--verde-claro); color: var(--verde); display: inline-flex; align-items: center; justify-content: center; }

  .cotizar { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 980px) { .cotizar { grid-template-columns: 0.85fr 1fr; gap: 64px; } }
  .cotizar__puntos { margin-top: 20px; }
</style>
