---
// Servicio de cenizas al mar (catálogo 2026). Va después de los 4 servicios funerarios, en una sección propia
// sobre verde: no es un paquete con ataúd y carroza, sino una ceremonia en yate. Datos en src/data/servicios.ts.
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import { enlaceWhatsApp } from '../config/site';
import { imagen } from '../lib/imagenes';
import { cenizasAlMar as c } from '../data/servicios';

const petalos = imagen('cenizas-petalos');
const familia = imagen('cenizas-familia');
const canastilla = imagen('cenizas-canastilla');
---
<article class="cenizas tono-oscuro sobre-verde" id={`servicio-${c.id}`} aria-labelledby="cenizas-titulo">
  <div class="contenedor cenizas__grid">
    <div class="cenizas__texto aparece">
      <p class="cenizas__etiqueta"><Icono nombre="waves" tam={20} /> Servicio</p>
      <h3 id="cenizas-titulo">{c.nombre}</h3>
      <p class="cenizas__lema">{c.lema}</p>
      <h4>Incluye</h4>
      <ul class="lista-check">
        {c.incluye.map((it) => <li><Icono nombre="check" tam={18} />{it}</li>)}
      </ul>
      <ul class="cenizas__notas">
        {c.notas.map((n) => <li>{n}</li>)}
      </ul>
      <a class="btn btn--dorado cenizas__cta" href={enlaceWhatsApp(`Hola Marco, quisiera información del servicio ${c.nombre}.`)} target="_blank" rel="noopener" data-ubicacion={`servicio-${c.id}`}>
        <Icono nombre="whatsapp-logo" tam={20} /> Consultar {c.nombre}
      </a>
    </div>

    <div class="cenizas__fotos aparece">
      <div class="cenizas__foto cenizas__foto--grande"><Picture src={petalos.src} alt={petalos.alt} formats={['webp']} widths={[480, 800, 1100]} sizes="(min-width: 980px) 640px, 92vw" /></div>
      <div class="cenizas__foto"><Picture src={familia.src} alt={familia.alt} formats={['webp']} widths={[400, 700]} sizes="(min-width: 980px) 310px, 45vw" /></div>
      <div class="cenizas__foto"><Picture src={canastilla.src} alt={canastilla.alt} formats={['webp']} widths={[400, 700]} sizes="(min-width: 980px) 310px, 45vw" /></div>
    </div>
  </div>
</article>

<style>
  .cenizas { background: var(--verde); color: var(--en-fondo); padding-block: clamp(56px, 8vw, 104px); }
  .cenizas__grid { display: grid; gap: 36px; }
  .cenizas__etiqueta {
    display: inline-flex; align-items: center; gap: 8px; margin: 0 0 2px;
    font-size: 0.85rem; font-weight: 600; color: var(--acento); text-transform: uppercase; letter-spacing: 0.08em;
  }
  .cenizas h3 { color: #fff; font-size: clamp(2.2rem, 4vw, 3rem); margin-bottom: 6px; }
  .cenizas__lema { color: var(--en-fondo-2); font-size: 1.08em; max-width: 46ch; margin-bottom: 22px; }
  .cenizas h4 { margin: 0 0 10px; font: 600 0.95rem/1.3 var(--f-texto); color: var(--acento); text-transform: uppercase; letter-spacing: 0.06em; }
  .cenizas .lista-check { gap: 8px; }
  .cenizas .lista-check :global(.icono) { color: var(--dorado); }
  .cenizas__notas { margin: 20px 0 0; padding: 16px 0 0 1.2em; border-top: 1px solid var(--linea); font-size: 0.9rem; color: var(--en-fondo-2); display: grid; gap: 4px; }
  .cenizas__cta { margin-top: 24px; }
  @media (max-width: 520px) { .cenizas__cta { width: 100%; } }

  .cenizas__fotos { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .cenizas__foto { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radio); }
  .cenizas__foto--grande { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
  .cenizas__foto :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 980px) {
    .cenizas__grid { grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 5vw, 80px); align-items: center; }
    .cenizas__fotos { gap: 16px; }
  }
</style>
