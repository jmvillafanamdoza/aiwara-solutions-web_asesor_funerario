---
// Servicios funerarios al estilo "escenario fijo + tarjeta que sube" (inspirado en recompose.life):
// cada servicio tiene un escenario de color que se queda fijo mientras su tarjeta de información
// sube por encima al hacer scroll. En celular se apilan (foto y tarjeta debajo).
// Debajo de la tarjeta, fuera de ella y sobre el mismo color, va la franja del servicio con el ataúd
// (cerrado y abierto, en cada forma, con sus medidas) y la carroza con el coche portaflores, como en el catálogo.
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import { enlaceWhatsApp } from '../config/site';
import { imagen, type Espacio } from '../lib/imagenes';
import { servicios, notasServicios } from '../data/servicios';

const traslado = (s: (typeof servicios)[number]) => {
  const items = s.grupos.find((g) => g.titulo === 'Traslado')?.items ?? [];
  if (!items.length) throw new Error(`El servicio "${s.id}" no tiene el grupo "Traslado" en src/data/servicios.ts (se usa en la franja de la carroza).`);
  return items;
};

const planes = servicios.map((s) => ({
  ...s,
  capilla: imagen(`serv-${s.id}-capilla` as Espacio),
  carroza: imagen(`serv-${s.id}-carroza` as Espacio),
  traslado: traslado(s),
  formas: s.formas.map((f) => {
    const base = `serv-${s.id}-ataud${f.forma === 'redondo' ? '-redondo' : ''}`;
    return { ...f, cerrado: imagen(base as Espacio), abierto: imagen(`${base}-abierto` as Espacio) };
  }),
}));

/** Separa el texto para resaltar los marcadores [ ... ] pendientes de confirmar. */
const partes = (texto: string) => texto.split(/(\[[^\]]+\])/).filter(Boolean).map((t) => ({ t, marcador: /^\[[^\]]+\]$/.test(t) }));
const mayuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---
<section class="planes" id="servicios" aria-labelledby="servicios-titulo">
  <div class="contenedor planes__intro">
    <h2 id="servicios-titulo" class="aparece">Servicios funerarios</h2>
    <p class="intro aparece">Cinco servicios para que cada familia elija según sus deseos. Baje para conocer qué incluye cada uno; le explico las diferencias y le doy el precio por teléfono o WhatsApp.</p>
    <nav class="planes__indice aparece" aria-label="Ir a un servicio">
      {planes.map((p) => <a href={`#servicio-${p.id}`}>{p.nombre}</a>)}
    </nav>
  </div>

  {planes.map((p) => (
    <article class={`plan plan--${p.tono}`} id={`servicio-${p.id}`} aria-labelledby={`plan-${p.id}-titulo`}>
      <div class="plan__fijo">
        <div class="plan__escena">
          <span class="plan__marca" aria-hidden="true">{p.nombre}</span>
          <Picture
            src={p.capilla.src} alt={p.capilla.alt} formats={['webp']} widths={[480, 800, 1200]}
            sizes="(min-width: 980px) 50vw, 92vw" class="plan__capilla"
          />
        </div>

        <div class="contenedor plan__capa">
          <div class="plan__card">
            <p class="plan__etiqueta">Servicio</p>
            <h3 id={`plan-${p.id}-titulo`}>{p.nombre}</h3>
            <p class="plan__lema">{p.lema}</p>

            <p class="plan__ataud">
              <span>{p.ataud}</span>
              <a href={`#servicio-${p.id}-ataud`}>Ver ataúd y carroza <Icono nombre="arrow-down" tam={16} /></a>
            </p>

            <div class="plan__grupos">
              {p.grupos.map((g) => (
                <div class="plan__grupo">
                  <h4>{g.titulo}</h4>
                  <ul class="lista-check">
                    {g.items.map((it) => <li><Icono nombre="check" tam={18} />{it}</li>)}
                  </ul>
                </div>
              ))}
            </div>

            <p class="plan__cortesia"><Icono nombre="gift" tam={20} /><span><strong>Cortesía:</strong> {p.cortesia}</span></p>

            <a class="btn btn--verde plan__cta" href={enlaceWhatsApp(`Hola Marco, quisiera información del servicio funerario ${p.nombre}.`)} target="_blank" rel="noopener" data-ubicacion={`servicio-${p.id}`}>
              <Icono nombre="whatsapp-logo" tam={20} /> Consultar el {p.nombre}
            </a>
          </div>
        </div>
      </div>

      <div class="plan__vitrina" id={`servicio-${p.id}-ataud`}>
        <div class="contenedor plan__vitrina-grid">
          <div class="plan__bloque aparece">
            <h4 class="plan__bloque-titulo">Ataúd · {p.nombre}</h4>
            <p class="plan__bloque-texto">{p.ataud}</p>
            {p.formas.map((f) => (
              <div class="plan__forma">
                {p.formas.length > 1 && <h5 class="plan__forma-titulo">{mayuscula(f.forma)}</h5>}
                <div class="plan__pares">
                  <figure>
                    <Picture src={f.cerrado.src} alt={f.cerrado.alt} formats={['webp']} widths={[320, 640]} sizes="(min-width: 980px) 340px, 45vw" />
                    <figcaption>Cerrado</figcaption>
                  </figure>
                  <figure>
                    <Picture src={f.abierto.src} alt={f.abierto.alt} formats={['webp']} widths={[320, 640]} sizes="(min-width: 980px) 340px, 45vw" />
                    <figcaption>Abierto</figcaption>
                  </figure>
                </div>
                <dl class="plan__medidas">
                  <div><dt><Icono nombre="ruler" tam={16} /> Medidas externas</dt><dd>{partes(f.externas).map((x) => x.marcador ? <span class="marcador">{x.t}</span> : x.t)}</dd></div>
                  <div><dt><Icono nombre="ruler" tam={16} /> Medidas internas</dt><dd>{partes(f.internas).map((x) => x.marcador ? <span class="marcador">{x.t}</span> : x.t)}</dd></div>
                </dl>
              </div>
            ))}
          </div>

          <div class="plan__bloque plan__bloque--carroza aparece">
            <h4 class="plan__bloque-titulo">Carroza y coche portaflores</h4>
            <p class="plan__bloque-texto">{p.traslado.map((t, i) => (i ? t.charAt(0).toLowerCase() + t.slice(1) : t)).join(' y ')}</p>
            <Picture src={p.carroza.src} alt={p.carroza.alt} formats={['webp']} widths={[480, 960]} sizes="(min-width: 980px) 520px, 92vw" class="plan__carroza" />
          </div>
        </div>
      </div>
    </article>
  ))}

  <div class="contenedor">
    <ul class="notas">
      {notasServicios.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>

<style>
  .planes { padding-top: clamp(56px, 9vw, 104px); }
  .planes__intro { margin-bottom: 32px; }
  .planes__indice { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .planes__indice a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px;
    border: 1px solid var(--gris-borde); border-radius: 999px; text-decoration: none;
    color: var(--verde-hondo); font-weight: 600; background: #fff;
  }
  .planes__indice a:hover { border-color: var(--verde); background: var(--verde-claro); }

  /* Colores de cada escenario (el texto de la franja cambia según el fondo; el dorado solo sobre verde) */
  .plan {
    --fondo: #e8ede9; --marca: rgb(22 58 40 / 0.07);
    --en-fondo: var(--verde-hondo); --en-fondo-2: var(--texto-2); --acento: var(--verde); --linea: rgb(22 58 40 / 0.14);
    position: relative; background: var(--fondo);
  }
  .plan--oscuro, .plan--bosque {
    --marca: rgb(255 255 255 / 0.07);
    --en-fondo: #fff; --en-fondo-2: rgb(255 255 255 / 0.82); --acento: var(--dorado); --linea: rgb(255 255 255 / 0.18);
  }
  .plan--oscuro { --fondo: #1d3d2c; }
  .plan--bosque { --fondo: #2b4a3a; }
  .plan--salvia { --fondo: #dce7df; }
  .plan--piedra { --fondo: #ebe7df; --marca: rgb(80 60 30 / 0.07); }
  .plan--niebla { --fondo: #eceeeb; }

  .plan__escena {
    position: relative; overflow: hidden; background: var(--fondo);
    display: grid; place-items: center; padding: 40px 16px 72px;
  }
  .plan__marca {
    position: absolute; left: 4vw; top: 2vh; white-space: nowrap; pointer-events: none;
    font: 600 clamp(4rem, 17vw, 15rem)/1 var(--f-titulo); color: var(--marca); letter-spacing: -0.01em;
  }
  .plan__escena :global(.plan__capilla) { position: relative; width: min(92vw, 560px); height: auto; filter: drop-shadow(0 18px 28px rgb(0 0 0 / 0.22)); }

  .plan__capa { position: relative; margin-top: -48px; padding-bottom: 8px; }
  .plan__card {
    position: relative; background: #fff; color: var(--tinta);
    border-radius: var(--radio); padding: clamp(22px, 4vw, 36px);
    box-shadow: 0 24px 60px -24px rgb(16 40 28 / 0.45);
  }
  .plan__etiqueta { margin: 0 0 2px; font-size: 0.85rem; font-weight: 600; color: var(--verde-medio); text-transform: uppercase; letter-spacing: 0.08em; }
  .plan__card h3 { font-size: clamp(2.2rem, 4vw, 3rem); margin-bottom: 6px; }
  .plan__lema { color: var(--texto-2); margin-bottom: 18px; }
  .plan__ataud {
    display: grid; gap: 4px; margin: 0 0 20px; padding: 12px 16px; border-radius: var(--radio);
    background: var(--gris-claro); font-weight: 600; color: var(--verde-hondo); line-height: 1.35;
  }
  .plan__ataud a { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; font-weight: 500; font-size: 0.95rem; }
  .plan__grupos { display: grid; gap: 18px; }
  .plan__grupo h4 { margin: 0 0 8px; font: 600 0.95rem/1.3 var(--f-texto); color: var(--verde); text-transform: uppercase; letter-spacing: 0.06em; }
  .plan__grupo .lista-check { gap: 6px; font-size: 0.98rem; }
  .plan__cortesia { display: grid; grid-template-columns: 22px 1fr; gap: 10px; margin: 20px 0 0; padding-top: 16px; border-top: 1px solid var(--gris-borde); font-size: 0.98rem; }
  .plan__cortesia :global(.icono) { color: var(--dorado); margin-top: 3px; }
  .plan__cta { margin-top: 20px; width: 100%; }

  /* Franja del servicio: ataúd y carroza, fuera de la tarjeta y sobre el color del escenario */
  .plan__vitrina { color: var(--en-fondo); padding-block: 40px 56px; scroll-margin-top: 72px; }
  .plan__vitrina-grid { display: grid; gap: 40px; }
  .plan__bloque-titulo { margin: 0 0 4px; font: 600 0.95rem/1.3 var(--f-texto); color: var(--acento); text-transform: uppercase; letter-spacing: 0.08em; }
  .plan__bloque-texto { margin: 0 0 16px; font: 600 clamp(1.4rem, 2.6vw, 1.9rem)/1.2 var(--f-titulo); color: var(--en-fondo); }
  .plan__forma + .plan__forma { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--linea); }
  .plan__forma-titulo { margin: 0 0 4px; font: 600 1rem/1.4 var(--f-texto); color: var(--en-fondo); }
  .plan__pares { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .plan__pares figure { margin: 0; }
  .plan__pares :global(img) {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain;
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.22));
  }
  .plan__pares figcaption { text-align: center; font-size: 0.88rem; color: var(--en-fondo-2); margin-top: 2px; }
  .plan__medidas { display: grid; gap: 6px; margin: 14px 0 0; font-size: 0.9rem; }
  .plan__medidas div { display: grid; gap: 0 10px; }
  .plan__medidas dt { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--en-fondo); }
  .plan__medidas dt :global(.icono) { color: var(--acento); }
  .plan__medidas dd { margin: 0; color: var(--en-fondo-2); }
  .plan__bloque--carroza :global(.plan__carroza) {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radio);
    box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.45);
  }
  .notas { padding-left: 1.2em; margin: 32px 0 0; font-size: 0.9rem; color: var(--texto-2); display: grid; gap: 4px; }

  @media (min-width: 600px) {
    .plan__medidas div { grid-template-columns: 190px 1fr; }
  }

  /* Escritorio: escenario fijo (sticky) y tarjeta que sube por encima a la derecha */
  @media (min-width: 980px) {
    .plan__escena {
      position: sticky; top: 72px; height: calc(100vh - 72px); min-height: 560px;
      padding: 0; place-items: center start;
    }
    .plan__escena :global(.plan__capilla) {
      position: absolute; left: max(32px, calc((100vw - var(--ancho)) / 2 + var(--gutter)));
      bottom: 7vh; width: min(48vw, 720px); max-height: 78%; object-fit: contain; object-position: left bottom;
    }
    .plan__marca { top: 4vh; }
    .plan__capa {
      display: flex; justify-content: flex-end; pointer-events: none;
      margin-top: calc(-1 * (100vh - 72px) + 22vh); padding-bottom: 12vh;
    }
    .plan__card { width: min(500px, 40vw); pointer-events: auto; }
    /* Evita que, con tarjetas cortas y pantallas altas, el escenario fijo se salga y tape la franja */
    .plan__fijo { min-height: max(calc(100vh - 72px), 560px); }

    .plan__vitrina { position: relative; padding-block: 24px 88px; }
    .plan__vitrina-grid { grid-template-columns: 1.35fr 1fr; gap: clamp(40px, 5vw, 80px); align-items: start; }
    .plan__pares { gap: 24px; }
    .plan__bloque--carroza { position: sticky; top: 104px; }
  }

  /* Entrada suave de cada tarjeta (sin movimiento si se pidió reducirlo) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .plan__card { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
    :global(.js) .plan__card.visible { opacity: 1; transform: none; }
    :global(.js) .plan__escena :global(.plan__capilla) { transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
  }
</style>

<script>
  // Muestra cada tarjeta cuando entra en pantalla.
  const tarjetas = document.querySelectorAll<HTMLElement>('.plan__card');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    tarjetas.forEach((t) => io.observe(t));
  } else {
    tarjetas.forEach((t) => t.classList.add('visible'));
  }
</script>
