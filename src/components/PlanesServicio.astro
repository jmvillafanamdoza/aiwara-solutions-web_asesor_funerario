---
// Servicios funerarios: cada servicio es UN cuadro del alto de la pantalla, sobre su color, con
// la vitrina a la izquierda (capilla ardiente, carroza y ataúdes cerrado/abierto con medidas) y la tarjeta
// de información a la derecha. Usa casi todo el ancho de la pantalla (hasta 1640 px). En celular se apila.
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import CenizasAlMar from './CenizasAlMar.astro';
import { SITE, enlaceWhatsApp } from '../config/site';
import { imagen, type Espacio } from '../lib/imagenes';
import { servicios, notasServicios, cenizasAlMar } from '../data/servicios';

const traslado = (s: (typeof servicios)[number]) => {
  const items = s.grupos.find((g) => g.titulo === 'Traslado')?.items ?? [];
  if (!items.length) throw new Error(`El servicio "${s.id}" no tiene el grupo "Traslado" en src/data/servicios.ts (se usa en la franja de la carroza).`);
  return items;
};

const planes = servicios.map((s) => ({
  ...s,
  capilla: imagen(`serv-${s.id}-capilla` as Espacio),
  carroza: imagen(`serv-${s.id}-carroza` as Espacio),
  traslado: traslado(s),
  formas: s.formas.map((f) => {
    const base = `serv-${s.id}-ataud${f.forma === 'redondo' ? '-redondo' : ''}`;
    return { ...f, cerrado: imagen(base as Espacio), abierto: imagen(`${base}-abierto` as Espacio) };
  }),
}));

/** Separa el texto para resaltar los marcadores [ ... ] pendientes de confirmar. */
const partes = (texto: string) => texto.split(/(\[[^\]]+\])/).filter(Boolean).map((t) => ({ t, marcador: /^\[[^\]]+\]$/.test(t) }));
const mayuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---
<section class="planes" id="servicios" aria-labelledby="servicios-titulo">
  <div class="contenedor planes__intro">
    <h2 id="servicios-titulo" class="aparece">Servicios funerarios</h2>
    <p class="intro aparece">Cinco servicios para que cada familia elija según sus deseos. Baje para conocer qué incluye cada uno; le explico las diferencias y le doy el precio por teléfono o WhatsApp.</p>
    <nav class="planes__indice aparece" aria-label="Ir a un servicio">
      {planes.map((p) => <a href={`#servicio-${p.id}`}>{p.nombre}</a>)}
      <a href={`#servicio-${cenizasAlMar.id}`}>{cenizasAlMar.nombre}</a>
    </nav>
    <a class="planes__catalogo aparece" href={SITE.catalogoPdf.ruta} download data-ubicacion="servicios-intro">
      <Icono nombre="file-pdf" tam={22} /> Descargar el catálogo completo <span class="planes__peso">(PDF, {SITE.catalogoPdf.peso})</span>
    </a>
  </div>

  {planes.map((p) => (
    <article class={`plan tono-${p.tono}`} id={`servicio-${p.id}`} aria-labelledby={`plan-${p.id}-titulo`}>
      <span class="plan__marca" aria-hidden="true">{p.nombre}</span>
      <div class="plan__cuadro">
        <!-- Vitrina: capilla, carroza y ataúdes del servicio en un solo bloque -->
        <div class={`plan__vitrina aparece${p.formas.length > 1 ? ' plan__vitrina--dos' : ''}`}>
          <figure class="plan__pieza plan__pieza--capilla">
            <Picture src={p.capilla.src} alt={p.capilla.alt} formats={['webp']} widths={[480, 800, 1200]} sizes="(min-width: 1100px) 32vw, 92vw" />
            <figcaption>Capilla ardiente</figcaption>
          </figure>
          <figure class="plan__pieza plan__pieza--carroza">
            <Picture src={p.carroza.src} alt={p.carroza.alt} formats={['webp']} widths={[480, 960]} sizes="(min-width: 1100px) 26vw, 92vw" />
            <figcaption>{p.traslado.map((t, i) => (i ? t.charAt(0).toLowerCase() + t.slice(1) : t)).join(' y ')}</figcaption>
          </figure>
          {p.formas.map((f, i) => (
              <div class={`plan__pieza plan__forma plan__forma--${i + 1}`}>
                <div class="plan__pares">
                  <Picture src={f.cerrado.src} alt={f.cerrado.alt} formats={['webp']} widths={[240, 480]} sizes="(min-width: 1100px) 12vw, 44vw" />
                  <Picture src={f.abierto.src} alt={f.abierto.alt} formats={['webp']} widths={[240, 480]} sizes="(min-width: 1100px) 12vw, 44vw" />
                </div>
                <p class="plan__medidas">
                  <strong>Ataúd {f.forma}</strong>
                  <span>Ext.: {partes(f.externas).map((x) => x.marcador ? <span class="marcador">{x.t}</span> : x.t)}</span>
                  <span>Int.: {partes(f.internas).map((x) => x.marcador ? <span class="marcador">{x.t}</span> : x.t)}</span>
                </p>
              </div>
            ))}
        </div>

        <!-- Tarjeta con la información del servicio -->
        <div class="plan__card">
          <p class="plan__etiqueta">Servicio</p>
          <h3 id={`plan-${p.id}-titulo`}>{p.nombre}</h3>
          <p class="plan__lema">{p.lema}</p>
          <p class="plan__ataud">{p.ataud}</p>

          <div class="plan__grupos">
            {p.grupos.map((g) => (
              <div class={`plan__grupo plan__grupo--${g.titulo.toLowerCase()}`}>
                <h4>{g.titulo}</h4>
                <ul class="lista-check">
                  {g.items.map((it) => <li><Icono nombre="check" tam={16} />{it}</li>)}
                </ul>
              </div>
            ))}
          </div>

          <p class="plan__cortesia"><Icono nombre="gift" tam={20} /><span><strong>Cortesía:</strong> {p.cortesia}</span></p>

          <a class="btn btn--verde plan__cta" href={enlaceWhatsApp(`Hola Marco, quisiera información del servicio funerario ${p.nombre}.`)} target="_blank" rel="noopener" data-ubicacion={`servicio-${p.id}`}>
            <Icono nombre="whatsapp-logo" tam={20} /> Consultar el {p.nombre}
          </a>
        </div>
      </div>
    </article>
  ))}

  <CenizasAlMar />

  <div class="contenedor">
    <ul class="notas">
      {notasServicios.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>

<style>
  .planes { padding-top: clamp(56px, 9vw, 104px); }
  .planes__intro { margin-bottom: 32px; }
  .planes__indice { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .planes__indice a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px;
    border: 1px solid var(--gris-borde); border-radius: 999px; text-decoration: none;
    color: var(--verde-hondo); font-weight: 600; background: #fff;
  }
  .planes__indice a:hover { border-color: var(--verde); background: var(--verde-claro); }
  .planes__catalogo { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; min-height: 44px; margin-top: 16px; font-weight: 600; }
  .planes__peso { font-weight: 400; color: var(--texto-2); }

  /* Colores de cada servicio: clases .tono-* en src/styles/global.css (el dorado solo sobre los verdes) */
  /* Cada servicio es un solo cuadro: vitrina (capilla, carroza, ataúdes) + tarjeta, usando casi todo el ancho */
  .plan { position: relative; overflow: hidden; background: var(--fondo); color: var(--en-fondo); padding-block: 40px 48px; scroll-margin-top: 72px; }
  .plan__marca {
    position: absolute; left: 3vw; top: 0; white-space: nowrap; pointer-events: none;
    font: 600 clamp(4rem, 15vw, 13rem)/1 var(--f-titulo); color: var(--marca); letter-spacing: -0.01em;
  }
  .plan__cuadro { position: relative; display: grid; gap: 24px; width: 100%; max-width: 1640px; margin-inline: auto; padding-inline: var(--gutter); }

  /* Vitrina */
  .plan__vitrina { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  .plan__pieza { margin: 0; min-width: 0; }
  .plan__pieza figcaption { margin-top: 6px; font-size: 0.86rem; color: var(--en-fondo-2); }
  .plan__pieza--capilla { grid-column: 1 / -1; text-align: center; }
  .plan__pieza--capilla :global(img) { width: min(100%, 520px); height: auto; margin-inline: auto; filter: drop-shadow(0 18px 26px rgb(0 0 0 / 0.25)); }
  .plan__pieza--carroza { grid-column: 1 / -1; }
  .plan__pieza--carroza :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 8; object-fit: cover; border-radius: var(--radio); box-shadow: 0 16px 36px -18px rgb(0 0 0 / 0.45); }
  .plan__forma { grid-column: 1 / -1; }
  .plan__pares { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .plan__pares :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: contain; filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.22)); }
  .plan__medidas { display: grid; gap: 1px; margin: 4px 0 0; font-size: 0.8rem; line-height: 1.35; color: var(--en-fondo-2); }
  .plan__medidas strong { color: var(--acento); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; }

  /* Tarjeta */
  .plan__card {
    position: relative; align-self: center; background: #fff; color: var(--tinta);
    border-radius: var(--radio); padding: clamp(20px, 2.4vw, 32px);
    box-shadow: 0 24px 60px -24px rgb(16 40 28 / 0.45);
  }
  .plan__etiqueta { margin: 0; font-size: 0.8rem; font-weight: 600; color: var(--verde-medio); text-transform: uppercase; letter-spacing: 0.08em; }
  .plan__card h3 { font-size: clamp(2.1rem, 3.2vw, 2.8rem); margin-bottom: 4px; }
  .plan__lema { color: var(--texto-2); margin-bottom: 12px; font-size: 0.98rem; }
  .plan__ataud { margin: 0 0 16px; padding: 10px 14px; border-radius: var(--radio); background: var(--gris-claro); font-weight: 600; color: var(--verde-hondo); line-height: 1.35; font-size: 0.98rem; }
  .plan__grupos { display: grid; gap: 14px; }
  .plan__grupo h4 { margin: 0 0 6px; font: 600 0.85rem/1.3 var(--f-texto); color: var(--verde); text-transform: uppercase; letter-spacing: 0.06em; }
  .plan__grupo .lista-check { gap: 4px; font-size: 0.92rem; line-height: 1.45; }
  .plan__grupo .lista-check li { grid-template-columns: 18px 1fr; gap: 8px; }
  .plan__cortesia { display: grid; grid-template-columns: 22px 1fr; gap: 10px; margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--gris-borde); font-size: 0.92rem; line-height: 1.45; }
  .plan__cortesia :global(.icono) { color: var(--dorado); margin-top: 2px; }
  .plan__cta { margin-top: 16px; width: 100%; min-height: 50px; }
  .notas { padding-left: 1.2em; margin: 32px 0 0; font-size: 0.9rem; color: var(--texto-2); display: grid; gap: 4px; }

  @media (min-width: 640px) {
    .plan__pieza--carroza { grid-column: 1; }
    .plan__forma--1 { grid-column: 2; align-self: start; }
    .plan__vitrina--dos .plan__forma--1 { grid-column: 1; }
    .plan__vitrina--dos .plan__forma--2 { grid-column: 2; }
    .plan__grupos { grid-template-columns: 1fr 1fr; column-gap: 24px; }
    .plan__grupo--ceremonia { grid-row: span 2; }
  }

  /* Escritorio: un cuadro del alto de la pantalla; vitrina a la izquierda y tarjeta a la derecha */
  @media (min-width: 1100px) {
    .plan { min-height: calc(100vh - 72px); display: grid; align-items: center; padding-block: 32px; }
    .plan__cuadro { grid-template-columns: 1.3fr 1fr; gap: clamp(28px, 3vw, 56px); align-items: center; padding-inline: clamp(24px, 3.5vw, 64px); }
    .plan__vitrina { grid-template-columns: 1.15fr 1fr; grid-template-rows: auto 1fr; gap: 18px 24px; align-items: center; }
    .plan__pieza--capilla { grid-column: 1; grid-row: 1 / span 2; }
    .plan__pieza--capilla :global(img) { width: 100%; max-width: none; max-height: calc(100vh - 220px); object-fit: contain; }
    .plan__pieza--carroza { grid-column: 2; grid-row: 1; }
    .plan__forma--1 { grid-column: 2; grid-row: 2; align-self: start; }
    /* Con ataúd cuadrado y redondo: capilla y carroza arriba; los dos ataúdes debajo, uno bajo cada una */
    .plan__vitrina--dos { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; align-items: end; }
    .plan__vitrina--dos .plan__pieza--capilla { grid-row: 1; }
    .plan__vitrina--dos .plan__pieza--capilla :global(img) { max-height: calc(50vh - 90px); }
    .plan__vitrina--dos .plan__forma--1 { grid-column: 1; grid-row: 2; }
    .plan__vitrina--dos .plan__forma--2 { grid-column: 2; grid-row: 2; align-self: start; }
    .plan__marca { top: 1vh; }
  }

  /* Laptops de poca altura (768-860 px): todo el servicio sigue cabiendo en una pantalla */
  @media (min-width: 1100px) and (max-height: 860px) {
    .plan { padding-block: 16px; }
    .plan__card { padding: 18px 24px; }
    .plan__card h3 { font-size: 2rem; }
    .plan__lema { margin-bottom: 8px; font-size: 0.92rem; }
    .plan__ataud { margin-bottom: 10px; padding: 8px 12px; font-size: 0.92rem; }
    .plan__grupos { gap: 8px; }
    .plan__grupo h4 { margin-bottom: 4px; }
    .plan__grupo .lista-check { gap: 2px; font-size: 0.86rem; line-height: 1.4; }
    .plan__cortesia { margin-top: 10px; padding-top: 8px; font-size: 0.86rem; line-height: 1.4; }
    .plan__cta { margin-top: 10px; min-height: 46px; }
    .plan__medidas { font-size: 0.76rem; }
  }

  /* Entrada suave de cada tarjeta (sin movimiento si se pidió reducirlo) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .plan__card { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
    :global(.js) .plan__card.visible { opacity: 1; transform: none; }
  }
</style>

<script>
  // Muestra cada tarjeta cuando entra en pantalla.
  const tarjetas = document.querySelectorAll<HTMLElement>('.plan__card');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    tarjetas.forEach((t) => io.observe(t));
  } else {
    tarjetas.forEach((t) => t.classList.add('visible'));
  }
</script>
