---
import Icono from './Icono.astro';
import { SITE, enlaceTelefono } from '../config/site';
interface Props { actual: string; }
const actual = Astro.props.actual.replace(/\/$/, '') || '/';
const items = SITE.nav.filter((i) => i.activo);
---
<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <a class="marca" href="/" aria-label={`${SITE.nombreCorto}, ${SITE.cargo} de ${SITE.empresa}. Ir al inicio`}>
      {SITE.logoJdlpAutorizado && (
        /* Espacio reservado para el logo oficial: agregar <img> cuando haya autorización. */
        <span class="marca__logo" />
      )}
      <span class="marca__nombre">{SITE.nombreCorto}</span>
      <span class="marca__cargo">{SITE.cargo} · {SITE.empresa}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul id="menu" class="nav__lista">
        {items.map((i) => (
          <li><a href={i.href} aria-current={actual === i.href ? 'page' : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--verde cabecera__llamar" href={enlaceTelefono} data-ubicacion="cabecera">
      <Icono nombre="phone" tam={20} />
      <span class="cabecera__llamar-texto">Llamar 24 h</span>
      <span class="sr-only">al {SITE.telefonoIntl}</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <Icono nombre="list" tam={26} />
    </button>
  </div>
</header>

<style>
  .cabecera {
    position: sticky; top: 0; z-index: 40;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--gris-borde);
  }
  .cabecera__fila { display: flex; align-items: center; gap: 16px; min-height: 72px; }
  .marca { display: grid; text-decoration: none; line-height: 1.15; margin-right: auto; }
  .marca__nombre { font: 600 1.55rem/1.05 var(--f-titulo); color: var(--verde-hondo); }
  .marca__cargo { font-size: 0.78rem; color: var(--texto-2); letter-spacing: 0.01em; }
  .nav__lista { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .nav__lista a {
    display: block; padding: 10px 14px; border-radius: var(--radio);
    color: var(--tinta); text-decoration: none; font-weight: 500;
  }
  .nav__lista a:hover { background: var(--verde-claro); color: var(--verde-hondo); }
  .nav__lista a[aria-current='page'] { color: var(--verde); box-shadow: inset 0 -2px 0 var(--dorado); border-radius: 0; }
  .cabecera__llamar { min-height: 48px; padding-inline: 18px; }
  .menu-btn {
    display: none; width: 48px; height: 48px; border-radius: var(--radio);
    border: 1px solid var(--gris-borde); background: #fff; color: var(--verde-hondo);
    align-items: center; justify-content: center; cursor: pointer;
  }

  @media (max-width: 860px) {
    .menu-btn { display: inline-flex; }
    .cabecera__llamar { padding-inline: 14px; }
    .nav { position: absolute; inset: 72px 0 auto 0; }
    .nav__lista {
      display: none; flex-direction: column; gap: 0;
      background: #fff; border-bottom: 1px solid var(--gris-borde);
      padding: 8px var(--gutter) 16px; box-shadow: var(--sombra);
    }
    .nav__lista.abierto { display: flex; }
    .nav__lista a { padding: 14px 8px; font-size: 1.1rem; border-bottom: 1px solid var(--gris-claro); border-radius: 0; }
  }
  @media (max-width: 480px) {
    .marca__nombre { font-size: 1.35rem; }
    .marca__cargo { font-size: 0.7rem; max-width: 22ch; }
    .cabecera__llamar-texto { display: none; }
    .cabecera__llamar { width: 48px; padding: 0; }
  }
</style>
