---
// Banner de consentimiento. La medición (GTM / GA4 / Pixel) solo se carga si la persona acepta.
// La lógica está en src/scripts/sitio.ts.
---
<section class="cookies" role="dialog" aria-modal="false" aria-labelledby="cookies-titulo" hidden data-banner-cookies>
  <div class="cookies__caja">
    <h2 id="cookies-titulo" class="cookies__titulo">Uso de cookies</h2>
    <p>
      Usamos cookies de medición para saber cómo se usa esta web y mejorar nuestros anuncios.
      Solo se activan si usted lo acepta. <a href="/privacidad#cookies">Más información</a>
    </p>
    <div class="cookies__botones">
      <button type="button" class="btn btn--verde" data-cookies="aceptado">Aceptar</button>
      <button type="button" class="btn btn--contorno" data-cookies="rechazado">Rechazar</button>
    </div>
  </div>
</section>

<style>
  .cookies { position: fixed; inset: auto 0 0 0; z-index: 60; padding: 12px; }
  .cookies[hidden] { display: none; }
  .cookies__caja {
    max-width: 760px; margin: 0 auto; background: #fff; color: var(--tinta);
    border: 1px solid var(--gris-borde); border-radius: var(--radio);
    box-shadow: 0 -6px 40px -12px rgb(22 58 40 / 0.4);
    padding: 20px; font-size: 1rem;
  }
  .cookies__titulo { font: 600 1.1rem/1.3 var(--f-texto); color: var(--verde-hondo); margin-bottom: 6px; }
  .cookies__botones { display: flex; flex-wrap: wrap; gap: 10px; }
  .cookies__botones .btn { min-height: 48px; flex: 1 1 140px; }
</style>
