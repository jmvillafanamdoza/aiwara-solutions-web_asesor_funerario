---
import Icono from './Icono.astro';
import { SITE, enlaceWhatsApp } from '../config/site';
interface Props { pagina: string; }
const mensaje = SITE.mensajesWhatsApp[Astro.props.pagina] ?? SITE.mensajesWhatsApp.inicio;
---
<a class="wa-flotante" href={enlaceWhatsApp(mensaje)} target="_blank" rel="noopener" data-ubicacion="flotante">
  <Icono nombre="whatsapp-logo" tam={30} />
  <span class="wa-flotante__texto">Escribir por WhatsApp</span>
</a>

<style>
  .wa-flotante {
    position: fixed; right: 16px; bottom: 16px; z-index: 50;
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 60px; padding: 0 22px 0 16px;
    background: #128c4a; color: #fff; text-decoration: none;
    font-weight: 600; border-radius: 999px;
    box-shadow: 0 10px 28px -8px rgb(18 60 38 / 0.55);
    transition: transform 0.15s ease, background-color 0.2s ease;
  }
  .wa-flotante:hover { background: #0f7a40; color: #fff; transform: translateY(-2px); }
  @media (max-width: 640px) {
    .wa-flotante { width: 60px; padding: 0; justify-content: center; }
    .wa-flotante__texto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
  /* En páginas con barra de llamada fija en el celular, la barra ya incluye WhatsApp. */
  @media (max-width: 767px) {
    :global(body:has(.barra-llamada)) .wa-flotante { display: none; }
  }
</style>
